# Default-deny build context. Keep only inputs used by the Dockerfile.
**
!Dockerfile
!.dockerignore
!requirements.txt
!pyproject.toml
!start.py
!mkdocs.platform.yml
!README.md
!LICENSE
!src/
!src/**
!egs/
!egs/**
!docs/
!docs/**
!scripts/
!scripts/docs/
!scripts/docs/**

# Never re-include credentials, local configurations, or generated/private data.
**/.env
**/.env.*
**/.llm_env
**/.llm_env.*
**/.secrets
**/.secrets.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/id_rsa
**/id_dsa
**/id_ed25519
**/config_private.py
**/config_private/**
egs/config.yaml
egs/config/cli.yaml
egs/config/platform/config.yaml
egs/config/platform/cli.yaml
egs/config/models/qlib.yaml
docs/audit/**
docs/archive/**
docs/reference/**
docs/research/**
docs/task*.md
**/.codex/**
**/.trae/**
**/.workbuddy/**
**/.qoder/**
**/.codebuddy/**
**/.agents/**
**/.git/**
**/.venv*/**
**/.tools/**
**/node_modules/**
**/__pycache__/**
**/*.py[cod]
**/.pytest_cache/**
**/.ruff_cache/**
**/.mypy_cache/**
**/.migration-records/**
