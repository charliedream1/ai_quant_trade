# Real market data is the default. Use mock only for deterministic local tests.
ALL_IN_ONE_DATA_MODE=real
ALL_IN_ONE_DATA_TIMEOUT_SECONDS=12
ALL_IN_ONE_DATA_CACHE_TTL_SECONDS=300
# Market HTTP client: disable system proxy by default to avoid broken local proxy blocking page callbacks.
# Retries only apply to 429/5xx responses; connection/read failures fail fast.
ALL_IN_ONE_DATA_HTTP_TRUST_ENV=false
ALL_IN_ONE_DATA_HTTP_RETRIES=1
ALL_IN_ONE_DATA_HTTP_BACKOFF_SECONDS=0.2
# Serialize Eastmoney requests to reduce IP rate-limit risk. Increase for large batch jobs.
ALL_IN_ONE_EASTMONEY_MIN_INTERVAL_SECONDS=1.0
ALL_IN_ONE_EASTMONEY_JITTER_MIN=0.1
ALL_IN_ONE_EASTMONEY_JITTER_MAX=0.5

# Optional TDX single-quote fallback. Install with: pip install ".[tdx]"
ALL_IN_ONE_TDX_ENABLED=false
ALL_IN_ONE_TDX_PROBE_TIMEOUT_SECONDS=0.4
ALL_IN_ONE_TDX_MAX_PROBE_SERVERS=3
ALL_IN_ONE_TDX_FAILURE_COOLDOWN_SECONDS=300

# Optional runtime paths and server settings.
ALL_IN_ONE_DATA_DIR=./data
ALL_IN_ONE_DB_PATH=./data/all_in_one.db
ALL_IN_ONE_DOCUMENT_STORAGE_DIR=./data/knowledge/documents
ALL_IN_ONE_MARKET_PARQUET_DIR=./data/market_lake/parquet
ALL_IN_ONE_DUCKDB_PATH=./data/market_lake/market.duckdb
ALL_IN_ONE_HOST=127.0.0.1
# Remote deployment: set token mode, a private token (32+ ASCII characters),
# explicit hostnames and HTTPS at the reverse proxy. Keep the token out of Git.
ALL_IN_ONE_ACCESS_MODE=local
ALL_IN_ONE_ACCESS_TOKEN=
ALL_IN_ONE_ACCESS_HOSTS=
ALL_IN_ONE_PORT=8000
ALL_IN_ONE_LOG_LEVEL=INFO
# UI theme: light, dark, or system. Browser toggle can override this per device.
ALL_IN_ONE_UI_THEME=light
ALL_IN_ONE_CHAN_ANALYZER_ROOT=
ALL_IN_ONE_HELP_DOCS_MOUNT_PATH=/help-docs
ALL_IN_ONE_HELP_DOCS_SITE_DIR=./data/help_site
ALL_IN_ONE_HELP_DOCS_AUTO_BUILD=true
# Real Codex chat is disabled in mock mode; enable only for a trusted local runner.
ALL_IN_ONE_ENABLE_REAL_CLI=false
ALL_IN_ONE_CODEX_CLI=codex
ALL_IN_ONE_CODEX_TIMEOUT_SECONDS=180
# Optional absolute qrun path when the current Python environment has no qrun.
# ALL_IN_ONE_QLIB_QRUN=
# Isolated Qlib signal worker; a project-relative environment directory works on Windows/Linux.
# ALL_IN_ONE_QLIB_PYTHON=.venv-qlib-secure
# Startup preflight: strict blocks mismatched interpreters; warn is explicit debug-only compatibility.
ALL_IN_ONE_RUNTIME_MODE=strict
ALL_IN_ONE_RUNTIME_ROLE=web
# Optional read-only Office converter. Defaults are in egs/file_preview.yaml.
# ALL_IN_ONE_PREVIEW_OFFICE=.tools/libreoffice/LibreOffice_26.8.1_Win_x86-64/SourceDir/LibreOffice/program/soffice.com

# Import provider keys from System Configuration > Environment Variables.
# OPENAI_API_KEY=

# Optional Langfuse tracing for AI Workbench GenericAgent only.
# Optional local Qoder CLI; use actual paths on your machine.
ALL_IN_ONE_QODER_CLI=
ALL_IN_ONE_QODER_CONFIG_DIR=
# Optional native generation providers; no implicit WorkBuddy desktop credential reuse.
ALL_IN_ONE_CODEX_CLI=
ALL_IN_ONE_TRAE_CLI=
ALL_IN_ONE_CODEBUDDY_CLI=
ALL_IN_ONE_TRAE_HOME=
ALL_IN_ONE_CODEBUDDY_CONFIG_DIR=
# Install optional dependency with: uv sync --extra observability
ALL_IN_ONE_GENERIC_AGENT_LANGFUSE_ENABLED=false
ALL_IN_ONE_GENERIC_AGENT_LANGFUSE_CAPTURE_CONTENT=false
ALL_IN_ONE_GENERIC_AGENT_LANGFUSE_FLUSH_ON_FINISH=true
ALL_IN_ONE_GENERIC_AGENT_LANGFUSE_ENVIRONMENT=local
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
