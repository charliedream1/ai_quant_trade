def propagate_attributes(**kwargs: Any) -> AbstractContextManager[Any]: ...

class Langfuse:
    def __init__(self, **kwargs: Any) -> None: ...
    def start_as_current_observation(self, **kwargs: Any) -> AbstractContextManager[Any]: ...
    def flush(self) -> None: ...
    def shutdown(self) -> None: ...
